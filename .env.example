# Database
POSTGRES_USER=momentscape
POSTGRES_PASSWORD=momentscape_password
POSTGRES_DB=momentscape_dev
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Backend API
API_PORT=5000
API_URL=http://localhost:${API_PORT}

# Frontend
NEXT_PUBLIC_API_URL=${API_URL}
FRONTEND_PORT=3000

# NextAuth
NEXTAUTH_URL=http://localhost:${FRONTEND_PORT}
NEXTAUTH_SECRET=replace-with-a-random-secret-at-least-32-chars
